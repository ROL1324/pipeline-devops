{
  "name": "pipeline-devops",
  "version": "2.0.0",
  "private": true,
  "description": "Pipeline DevOps de ejemplo: app de saludos con CI en GitHub Actions y CD con Docker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:property": "jest tests/property",
    "test:coverage": "jest --coverage",
    "security": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run test:coverage && npm run security",
    "docs:build": "node scripts/build-docs.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "marked": "^18.2.1",
    "supertest": "^7.3.2"
  }
}
